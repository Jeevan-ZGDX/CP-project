    "undici": "^5.14.0",
    "uuid": "^11.1.1",
    "protobufjs": "^7.5.4",
    "elliptic": "^6.6.1",
    "circuit-breaker-js": "0.0.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
